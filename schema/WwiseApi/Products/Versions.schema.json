{
	"type": "object",
	"required": ["statusCode", "data"],
	"additionalProperties": false,
	"$defs": {
		"crossoverBottleName": {
			"type": "string",
			"minLength": 1
		},
		"macOS": {
			"type": "object",
			"required": [
				"IS_USING_ROOT_LIBRARY",
				"minimumRequiredVersion"
			],
			"additionalProperties": false,
			"properties": {
				"IS_USING_ROOT_LIBRARY": {
					"type": "boolean"
				},
				"minimumRequiredVersion": {
					"type": "object",
					"required": ["major", "minor"],
					"additionalProperties": false,
					"properties": {
						"major": {
							"type": "integer",
							"minimum": 10
						},
						"minor": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				"skipWinePrefix": {
					"type": "boolean",
					"const": true
				}
			}
		},
		"plugins": {
			"type": "object",
			"required": [
				"oldestSupportedWwiseVersion"
			],
			"additionalProperties": false,
			"properties": {
				"oldestSupportedWwiseVersion": {
					"type": "object",
					"required": ["major", "year"],
					"additionalProperties": false,
					"properties": {
						"major": {
							"type": "integer",
							"minimum": 1
						},
						"year": {
							"type": "integer",
							"minimum": 2000
						}
					}
				}
			}
		}
	},
	"properties": {
		"statusCode": {
			"type": "integer",
			"const": 200
		},
		"data": {
			"type": "object",
			"required": ["bundles"],
			"additionalProperties": false,
			"properties": {
				"bundles": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": [
							"id",
							"tag",
							"versionTag",
							"published",
							"stable",
							"type",
							"name",
							"versionName",
							"description",
							"requiredLicenseId",
							"productDependentData",
							"vendor",
							"version",
							"documentation",
							"links",
							"$checked",
							"$unlocked",
							"$visible",
							"$disabled",
							"$message",
							"$sortGroupIndex",
							"applicable",
							"automaticDeletion",
							"supported",
							"categoryId",
							"image",
							"labels",
							"initialPublishDate",
							"updateDate",
							"publishDate"
						],
						"additionalProperties": false,
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"tag": {
								"type": "string",
								"minLength": 1
							},
							"versionTag": {
								"type": "string",
								"minLength": 1
							},
							"published": {
								"type": "integer",
								"enum": [
									0,
									1
								]
							},
							"stable": {
								"type": "integer",
								"enum": [
									0,
									1
								]
							},
							"type": {
								"type": "string",
								"minLength": 1
							},
							"name": {
								"type": "string",
								"minLength": 1
							},
							"versionName": {
								"type": "string",
								"minLength": 1
							},
							"description": {
								"type": "null"
							},
							"requiredLicenseId": {
								"type": "integer",
								"enum": [0, 1]
							},
							"productDependentData": {
								"oneOf": [
									{
										"type": "object",
										"maxProperties": 0
									},
									{
										"type": "object",
										"required": [
											"crossoverBottleName"
										],
										"additionalProperties": false,
										"properties": {
											"crossoverBottleName": {
												"$ref": "#/$defs/crossoverBottleName"
											},
											"macOS": {
												"$ref": "#/$defs/macOS"
											},
											"plugins": {
												"$ref": "#/$defs/plugins"
											}
										}
									}
								]
							},
							"vendor": {
								"type": "string",
								"minLength": 1
							},
							"version": {
								"type": "object",
								"required": [
									"build",
									"major",
									"minor",
									"nickname",
									"year"
								],
								"additionalProperties": false,
								"properties": {
									"build": {
										"type": "integer",
										"minimum": 1
									},
									"major": {
										"type": "integer",
										"minimum": 0
									},
									"minor": {
										"type": "integer",
										"minimum": 0
									},
									"nickname": {
										"type": "string"
									},
									"year": {
										"type": "integer",
										"minimum": 2000
									}
								}
							},
							"documentation": {
								"type": "array",
								"minItems": 0,
								"maxItems": 0
							},
							"links": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "object",
									"required": [
										"displayName",
										"id",
										"url"
									],
									"additionalProperties": false,
									"properties": {
										"displayName": {
											"type": "string",
											"minLength": 1
										},
										"id": {
											"type": "string",
											"minLength": 1
										},
										"url": {
											"type": "string",
											"minLength": 1
										}
									}
								}
							},
							"$checked": {
								"type": "null"
							},
							"$unlocked": {
								"type": "null"
							},
							"$visible": {
								"type": "null"
							},
							"$disabled": {
								"type": "null"
							},
							"$message": {
								"type": "null"
							},
							"$sortGroupIndex": {
								"type": "integer",
								"minimum": 0
							},
							"applicable": {
								"type": "null"
							},
							"automaticDeletion": {
								"type": "integer",
								"enum": [0, 1]
							},
							"supported": {
								"type": "integer",
								"enum": [0, 1]
							},
							"categoryId": {
								"type": "integer",
								"minimum": 1
							},
							"image": {
								"type": "null"
							},
							"labels": {
								"type": "array",
								"minItems": 0,
								"items": {
									"type": "object",
									"required": [
										"class",
										"displayName"
									],
									"additionalProperties": false,
									"properties": {
										"class": {
											"type": "string",
											"enum": [
												"info",
												"danger"
											]
										},
										"displayName": {
											"type": "string",
											"minLength": 1
										}
									}
								}
							},
							"launcher": {
								"type": "object",
								"required": ["minimumRequiredVersion"],
								"additionalProperties": false,
								"properties": {
									"minimumRequiredVersion": {
										"type": "object",
										"required": [
											"major",
											"minor",
											"year"
										],
										"properties": {
											"major": {
												"type": "integer",
												"minimum": 0
											},
											"minor": {
												"type": "integer",
												"minimum": 0
											},
											"year": {
												"type": "integer",
												"minimum": 2000
											}
										}
									}
								}
							},
							"initialPublishDate": {
								"type": "integer",
								"$comment": "UNIX epoch in milliseconds"
							},
							"updateDate": {
								"oneOf": [
									{
										"type": "integer",
										"$comment": "UNIX epoch in milliseconds"
									},
									{
										"type": "null"
									}
								]
							},
							"publishDate": {
								"oneOf": [
									{
										"type": "integer",
										"$comment": "UNIX epoch in milliseconds"
									},
									{
										"type": "null"
									}
								]
							}
						}
					}
				}
			}
		}
	}
}
