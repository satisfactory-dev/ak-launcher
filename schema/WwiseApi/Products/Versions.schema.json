{
	"$id": "https://satisfactory.dev/https://satisfactory.dev/ak-launcher/WwiseApi/Products/Version.schema.jsons.schema.json",
	"type": "object",
	"required": ["statusCode", "data"],
	"additionalProperties": false,
	"$defs": {
		"item": {
			"type": "object",
			"$ref": "https://satisfactory.dev/https://satisfactory.dev/ak-launcher/WwiseApi/Products/Version.schema.jsons.schema.json#/$defs/item",
			"required": [
				"versionTag",
				"published",
				"stable",
				"versionName",
				"description",
				"requiredLicenseId",
				"documentation",
				"automaticDeletion",
				"supported",
				"categoryId",
				"image",
				"updateDate",
				"publishDate"
			],
			"unevaluatedProperties": false,
			"properties": {
				"versionTag": {
					"type": "string",
					"minLength": 1
				},
				"published": {
					"type": "integer",
					"enum": [0, 1]
				},
				"stable": {
					"type": "integer",
					"enum": [0, 1]
				},
				"versionName": {
					"type": "string",
					"minLength": 1
				},
				"description": {
					"type": "null"
				},
				"requiredLicenseId": {
					"type": "integer",
					"enum": [0, 1]
				},
				"documentation": {
					"type": "array",
					"minItems": 0,
					"maxItems": 0
				},
				"automaticDeletion": {
					"type": "integer",
					"enum": [0, 1]
				},
				"supported": {
					"type": "integer",
					"enum": [0, 1]
				},
				"categoryId": {
					"type": "integer",
					"minimum": 1
				},
				"image": {
					"type": "null"
				},
				"updateDate": {
					"oneOf": [
						{
							"type": "integer",
							"$comment": "UNIX epoch in milliseconds"
						},
						{
							"type": "null"
						}
					]
				},
				"publishDate": {
					"oneOf": [
						{
							"type": "integer",
							"$comment": "UNIX epoch in milliseconds"
						},
						{
							"type": "null"
						}
					]
				}
			}
		}
	},
	"properties": {
		"statusCode": {
			"type": "integer",
			"const": 200
		},
		"data": {
			"type": "object",
			"required": ["bundles"],
			"additionalProperties": false,
			"properties": {
				"bundles": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "https://satisfactory.dev/ak-launcher/WwiseApi/Products/Version.schema.json#/$defs/item"
					}
				}
			}
		}
	}
}
