{
	"$id": "https://satisfactory.dev/ak-launcher/WwiseApi/Products/Version.schema.json",
	"type": "object",
	"required": ["statusCode", "data"],
	"additionalProperties": false,
	"$defs": {
		"filename_pkg": {
			"type": "string",
			"pattern": "^([A-Za-z0-9][A-Za-z0-9_.-]*\\.)pkg$"
		},
		"filename_xz": {
			"type": "string",
			"pattern": "^([A-Za-z0-9][A-Za-z0-9_-]*\\.)+tar\\.xz$"
		},
		"filename_zip": {
			"type": "string",
			"pattern": "^([A-Za-z0-9][A-Za-z0-9_-]*\\.)+zip$"
		},
		"filename_exe": {
			"type": "string",
			"pattern": "^([A-Za-z0-9][A-Za-z0-9_.-]*\\.)+exe$"
		},
		"nicknamed_version": {
			"type": "object",
			"required": ["build", "major", "minor", "nickname", "year"],
			"additionalProperties": false,
			"properties": {
				"build": {
					"type": "integer",
					"minimum": 1
				},
				"major": {
					"type": "integer",
					"minimum": 0
				},
				"minor": {
					"type": "integer",
					"minimum": 0
				},
				"nickname": {
					"type": "string"
				},
				"year": {
					"type": "integer",
					"minimum": 2000
				}
			}
		},
		"crossoverBottleName": {
			"type": "string",
			"minLength": 1
		},
		"macOS": {
			"type": "object",
			"required": ["IS_USING_ROOT_LIBRARY", "minimumRequiredVersion"],
			"additionalProperties": false,
			"properties": {
				"IS_USING_ROOT_LIBRARY": {
					"type": "boolean"
				},
				"minimumRequiredVersion": {
					"type": "object",
					"required": ["major", "minor"],
					"additionalProperties": false,
					"properties": {
						"major": {
							"type": "integer",
							"minimum": 10
						},
						"minor": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				"skipWinePrefix": {
					"type": "boolean",
					"const": true
				}
			}
		},
		"plugins": {
			"type": "object",
			"required": ["oldestSupportedWwiseVersion"],
			"additionalProperties": false,
			"properties": {
				"oldestSupportedWwiseVersion": {
					"type": "object",
					"required": ["major", "year"],
					"additionalProperties": false,
					"properties": {
						"major": {
							"type": "integer",
							"minimum": 1
						},
						"year": {
							"type": "integer",
							"minimum": 2000
						}
					}
				}
			}
		},
		"item--base": {
			"type": "object",
			"required": [
				"id",
				"tag",
				"type",
				"name",
				"vendor",
				"version",
				"$checked",
				"$unlocked",
				"$visible",
				"$disabled",
				"$message",
				"$sortGroupIndex",
				"applicable",
				"initialPublishDate"
			],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"tag": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"vendor": {
					"type": "string",
					"minLength": 1
				},
				"version": {
					"$ref": "#/$defs/nicknamed_version"
				},
				"$checked": {
					"type": "null"
				},
				"$unlocked": {
					"type": "null"
				},
				"$visible": {
					"type": "null"
				},
				"$disabled": {
					"type": "null"
				},
				"$message": {
					"type": "null"
				},
				"$sortGroupIndex": {
					"type": "integer",
					"minimum": 0
				},
				"applicable": {
					"type": "null"
				},
				"launcher": {
					"type": "object",
					"required": ["minimumRequiredVersion"],
					"additionalProperties": false,
					"properties": {
						"minimumRequiredVersion": {
							"type": "object",
							"required": ["major", "minor", "year"],
							"properties": {
								"major": {
									"type": "integer",
									"minimum": 0
								},
								"minor": {
									"type": "integer",
									"minimum": 0
								},
								"year": {
									"type": "integer",
									"minimum": 2000
								}
							}
						}
					}
				},
				"initialPublishDate": {
					"type": "integer",
					"$comment": "UNIX epoch in milliseconds"
				}
			}
		},
		"item": {
			"type": "object",
			"$ref": "#/$defs/item--base",
			"required": ["productDependentData", "links", "labels"],
			"properties": {
				"productDependentData": {
					"oneOf": [
						{
							"type": "object",
							"maxProperties": 0
						},
						{
							"type": "object",
							"required": ["crossoverBottleName"],
							"additionalProperties": false,
							"properties": {
								"crossoverBottleName": {
									"$ref": "#/$defs/crossoverBottleName"
								},
								"macOS": {
									"$ref": "#/$defs/macOS"
								},
								"plugins": {
									"$ref": "#/$defs/plugins"
								}
							}
						}
					]
				},
				"links": {
					"type": "array",
					"minItems": 0,
					"items": {
						"type": "object",
						"required": ["displayName", "id", "url"],
						"additionalProperties": false,
						"properties": {
							"displayName": {
								"type": "string",
								"minLength": 1
							},
							"id": {
								"type": "string",
								"minLength": 1
							},
							"url": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				},
				"labels": {
					"type": "array",
					"minItems": 0,
					"items": {
						"type": "object",
						"required": ["class", "displayName"],
						"additionalProperties": false,
						"properties": {
							"class": {
								"type": "string",
								"enum": ["info", "danger"]
							},
							"displayName": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				}
			}
		},
		"data_groups_item_values_item": {
			"type": "object",
			"required": ["displayName", "eulaIds", "id"],
			"properties": {
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"eulaIds": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"id": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"data_groups_item_values_item_license": {
			"type": "object",
			"$ref": "#/$defs/data_groups_item_values_item",
			"required": ["license"],
			"properties": {
				"license": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"platform": {
							"type": "string",
							"enum": [
								"Android",
								"iOS",
								"Mac",
								"Linux",
								"Emscripten",
								"OpenHarmony",
								"Windows",
								"XboxOne",
								"Switch",
								"Ounce",
								"PS4",
								"PS5",
								"XboxSeriesX"
							]
						}
					}
				}
			}
		},
		"data_groups_item_values_item_applicable": {
			"type": "object",
			"required": ["applicable"],
			"properties": {
				"applicable": {
					"type": "string",
					"enum": ["isOSX", "isWindows"]
				}
			}
		},
		"data_groups_item_values_item_checked": {
			"type": "object",
			"required": ["$checked"],
			"properties": {
				"$checked": {
					"type": "boolean"
				}
			}
		},
		"data_groups_item_values_item_visible": {
			"type": "object",
			"$ref": "#/$defs/data_groups_item_values_item",
			"required": ["$visible"],
			"properties": {
				"$visible": {
					"oneOf": [
						{
							"type": "boolean"
						},
						{
							"type": "string",
							"const": "hasNoMessage"
						}
					]
				}
			}
		},
		"data_groups_item_values_item_description": {
			"type": "object",
			"$ref": "#/$defs/data_groups_item_values_item",
			"required": ["description"],
			"properties": {
				"description": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"data_groups_item": {
			"type": "object",
			"required": ["displayName", "id", "values"],
			"properties": {
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"id": {
					"type": "string",
					"minLength": 1
				},
				"values": {
					"type": "array",
					"minItems": 1,
					"items": {
						"oneOf": [
							{
								"type": "object",
								"unevaluatedProperties": false,
								"$ref": "#/$defs/data_groups_item_values_item"
							},
							{
								"type": "object",
								"unevaluatedProperties": false,
								"$ref": "#/$defs/data_groups_item_values_item_license"
							},
							{
								"type": "object",
								"unevaluatedProperties": false,
								"allOf": [
									{
										"$ref": "#/$defs/data_groups_item_values_item_license"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_visible"
									}
								]
							},
							{
								"type": "object",
								"unevaluatedProperties": false,
								"allOf": [
									{
										"$ref": "#/$defs/data_groups_item_values_item"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_applicable"
									}
								]
							},
							{
								"type": "object",
								"unevaluatedProperties": false,
								"allOf": [
									{
										"$ref": "#/$defs/data_groups_item_values_item"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_checked"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_visible"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_description"
									}
								]
							},
							{
								"type": "object",
								"unevaluatedProperties": false,
								"allOf": [
									{
										"$ref": "#/$defs/data_groups_item_values_item"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_checked"
									}
								]
							},
							{
								"type": "object",
								"unevaluatedProperties": false,
								"allOf": [
									{
										"$ref": "#/$defs/data_groups_item_values_item"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_checked"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_applicable"
									}
								]
							},
							{
								"type": "object",
								"unevaluatedProperties": false,
								"allOf": [
									{
										"$ref": "#/$defs/data_groups_item_values_item"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_applicable"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_checked"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_visible"
									},
									{
										"$ref": "#/$defs/data_groups_item_values_item_description"
									}
								]
							}
						]
					}
				}
			}
		},
		"data_item_file": {
			"type": "object",
			"$ref": "#/$defs/data_item_file--base",
			"required": ["documentationFiles", "groups"],
			"properties": {
				"documentationFiles": {
					"type": "array",
					"minItems": 0,
					"items": {
						"type": "object",
						"required": ["displayName", "path"],
						"additionalProperties": false,
						"properties": {
							"displayName": {
								"type": "string",
								"minLength": 1
							},
							"path": {
								"type": "string",
								"pattern": "^(\\\\[A-Za-z0-9][A-Za-z0-9_-]*)+\\.(chm|pdf)$"
							}
						}
					}
				},
				"groups": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["groupId", "groupValueId"],
						"unevaluatedProperties": false,
						"oneOf": [
							{
								"type": "object",
								"required": ["groupId", "groupValueId"],
								"additionalProperties": false,
								"properties": {
									"groupId": {
										"type": "string",
										"const": "Packages"
									},
									"groupValueId": {
										"type": "string",
										"enum": [
											"Authoring",
											"Documentation",
											"SDK"
										]
									}
								}
							},
							{
								"type": "object",
								"required": ["groupId", "groupValueId"],
								"additionalProperties": false,
								"properties": {
									"groupId": {
										"type": "string",
										"const": "AuthoringPlatforms"
									},
									"groupValueId": {
										"type": "string",
										"enum": ["x64"]
									}
								}
							},
							{
								"type": "object",
								"required": ["groupId", "groupValueId"],
								"additionalProperties": false,
								"properties": {
									"groupId": {
										"type": "string",
										"const": "AuthoringOS"
									},
									"groupValueId": {
										"type": "string",
										"enum": ["Windows", "OSX"]
									}
								}
							},
							{
								"type": "object",
								"required": ["groupId", "groupValueId"],
								"additionalProperties": false,
								"properties": {
									"groupId": {
										"type": "string",
										"const": "DeploymentPlatforms"
									},
									"groupValueId": {
										"type": "string",
										"enum": [
											"WinGC",
											"Windows_vc160",
											"Windows_vc170",
											"Linux",
											"Android",
											"iOS",
											"tvOS",
											"visionOS",
											"Mac"
										]
									}
								}
							}
						]
					}
				}
			}
		},
		"data_item_file--base": {
			"allOf": [
				{
					"type": "object",
					"required": [
						"licenses",
						"sha1",
						"size",
						"uncompressedSize"
					],
					"properties": {
						"licenses": {
							"type": "array",
							"minItems": 0,
							"maxItems": 0
						},
						"sha1": {
							"type": "string",
							"pattern": "^[a-f0-9]{40}$"
						},
						"size": {
							"oneOf": [
								{
									"type": "integer",
									"$comment": "since we're not using ajv-specific keywords, take care to verify uncompressedSize is equal to or greater than size",
									"minimum": 0
								},
								{
									"type": "string",
									"pattern": "^\\d+$"
								}
							]
						},
						"uncompressedSize": {
							"oneOf": [
								{
									"type": "integer",
									"$comment": "since we're not using ajv-specific keywords, take care to verify uncompressedSize is equal to or greater than size",
									"minimum": 0
								},
								{
									"type": "string",
									"pattern": "^\\d+$"
								}
							]
						}
					}
				},
				{
					"oneOf": [
						{
							"type": "object",
							"required": ["id", "name", "sourceName"],
							"properties": {
								"id": {
									"$ref": "#/$defs/filename_xz"
								},
								"name": {
									"$ref": "#/$defs/filename_xz"
								},
								"sourceName": {
									"$ref": "#/$defs/filename_xz"
								}
							}
						},
						{
							"type": "object",
							"required": ["id", "name", "sourceName"],
							"properties": {
								"id": {
									"$ref": "#/$defs/filename_zip"
								},
								"name": {
									"$ref": "#/$defs/filename_zip"
								},
								"sourceName": {
									"$ref": "#/$defs/filename_zip"
								}
							}
						},
						{
							"type": "object",
							"required": ["id", "name", "sourceName"],
							"properties": {
								"id": {
									"$ref": "#/$defs/filename_pkg"
								},
								"name": {
									"$ref": "#/$defs/filename_pkg"
								},
								"sourceName": {
									"$ref": "#/$defs/filename_pkg"
								}
							}
						},
						{
							"type": "object",
							"required": ["id", "name", "sourceName"],
							"properties": {
								"id": {
									"$ref": "#/$defs/filename_exe"
								},
								"name": {
									"$ref": "#/$defs/filename_exe"
								},
								"sourceName": {
									"$ref": "#/$defs/filename_exe"
								}
							}
						}
					]
				}
			]
		},
		"data_item--base": {
			"type": "object",
			"required": ["files"],
			"properties": {
				"files": {
					"type": "array",
					"minItems": 1,
					"items": {
						"oneOf": [
							{
								"type": "object",
								"unevaluatedProperties": false,
								"$ref": "#/$defs/data_item_file--base"
							},
							{
								"type": "object",
								"unevaluatedProperties": false,
								"$ref": "#/$defs/data_item_file"
							}
						]
					}
				}
			}
		},
		"data_item": {
			"type": "object",
			"$ref": "#/$defs/data_item--base",
			"required": ["eulas", "executables", "groups"],
			"properties": {
				"eulas": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["displayName", "fileName", "id"],
						"additionalProperties": false,
						"properties": {
							"displayName": {
								"type": "string",
								"minLength": 1
							},
							"fileName": {
								"type": "string",
								"pattern": "^[A-Za-z0-9]+\\.txt$"
							},
							"id": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				},
				"executables": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["files", "groupId", "id"],
						"additionalProperties": false,
						"properties": {
							"files": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "object",
									"required": [
										"architecture",
										"config",
										"displayName",
										"filePath",
										"os"
									],
									"unevaluatedProperties": false,
									"properties": {
										"architecture": {
											"type": "string",
											"$comment": "yes, this should probably be an enum",
											"const": "amd64"
										},
										"displayName": {
											"type": "string",
											"minLength": 1
										}
									},
									"oneOf": [
										{
											"properties": {
												"os": {
													"type": "string",
													"const": "Windows"
												}
											},
											"oneOf": [
												{
													"properties": {
														"config": {
															"type": "string",
															"const": "Release"
														},
														"filePath": {
															"type": "string",
															"pattern": "^Authoring/x64/Release/bin/([^\\.]+\\.)+exe$"
														}
													}
												},
												{
													"properties": {
														"config": {
															"type": "string",
															"const": "Debug"
														},
														"filePath": {
															"type": "string",
															"pattern": "^Authoring/x64/Debug/bin/([^\\.]+\\.)+exe$"
														}
													}
												}
											]
										},
										{
											"properties": {
												"config": {
													"type": "string",
													"const": "Release"
												},
												"os": {
													"type": "string",
													"const": "Mac"
												},
												"filePath": {
													"type": "string",
													"pattern": "^[A-Za-z0-9]+\\.app$"
												}
											}
										}
									]
								}
							},
							"groupId": {
								"type": "string",
								"minLength": 1
							},
							"id": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				},
				"groups": {
					"type": "array",
					"minItems": 1,
					"items": {
						"oneOf": [
							{
								"type": "object",
								"unevaluatedProperties": false,
								"$ref": "#/$defs/data_groups_item"
							},
							{
								"type": "object",
								"unevaluatedProperties": false,
								"$ref": "#/$defs/data_groups_item",
								"required": ["$visible"],
								"properties": {
									"$visible": {
										"type": "boolean"
									}
								}
							}
						]
					}
				}
			}
		},
		"data_item_with_redistributables": {
			"type": "object",
			"$ref": "#/$defs/data_item",
			"required": ["redistributables"],
			"properties": {
				"redistributables": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": [
							"displayName",
							"fileName",
							"requirements",
							"url"
						],
						"additionalProperties": false,
						"properties": {
							"displayName": {
								"type": "string",
								"minLength": 1
							},
							"fileName": {
								"$ref": "#/$defs/filename_exe"
							},
							"requirements": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "object",
									"required": [
										"key",
										"minVersion",
										"type",
										"valueName"
									],
									"additionalProperties": false,
									"properties": {
										"key": {
											"type": "object",
											"required": [
												"hKey",
												"keyPath",
												"wow64"
											],
											"additionalProperties": false,
											"properties": {
												"hKey": {
													"type": "string",
													"const": "HKLM"
												},
												"keyPath": {
													"type": "string",
													"pattern": "^([A-Za-z][A-Za-z0-9 ]+\\\\)+[A-Za-z][A-Za-z0-9 ]+$"
												},
												"wow64": {
													"type": "boolean"
												}
											}
										},
										"minVersion": {
											"type": "string",
											"pattern": "^\\d+\\.\\d+$"
										},
										"type": {
											"type": "string",
											"const": "regKeyVersion"
										},
										"valueName": {
											"type": "string",
											"const": "Version"
										}
									}
								}
							},
							"url": {
								"type": "string",
								"pattern": "^https:\\/\\/.+"
							}
						}
					}
				}
			}
		}
	},
	"properties": {
		"statusCode": {
			"type": "integer",
			"const": 200
		},
		"data": {
			"oneOf": [
				{
					"type": "object",
					"unevaluatedProperties": false,
					"allOf": [
						{
							"$ref": "#/$defs/item--base"
						},
						{
							"$ref": "#/$defs/data_item--base"
						}
					]
				},
				{
					"type": "object",
					"unevaluatedProperties": false,
					"allOf": [
						{
							"$ref": "#/$defs/item"
						},
						{
							"$ref": "#/$defs/data_item"
						}
					]
				},
				{
					"type": "object",
					"unevaluatedProperties": false,
					"allOf": [
						{
							"$ref": "#/$defs/item"
						},
						{
							"$ref": "#/$defs/data_item_with_redistributables"
						}
					]
				}
			]
		}
	}
